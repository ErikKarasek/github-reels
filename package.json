{
  "name": "github-reels",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Scrapne GitHub Trending + AI novinky a napíše scénáře na reels",
  "scripts": {
    "scout": "node src/index.js --no-scripts",
    "reels": "node src/index.js",
    "site": "node src/site.js",
    "deploy": "node src/site.js && wrangler deploy",
    "preview": "node src/site.js && wrangler dev",
    "reel": "node --env-file-if-exists=.env src/reel.js",
    "specs": "node src/spec.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "sharp": "^0.35.5"
  }
}
